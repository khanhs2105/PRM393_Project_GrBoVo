rules_version = '2';

// Luật bảo mật Cloud Firestore cho Alo, Trả Tiền!.
// Dán nội dung file này vào Firebase Console > Firestore Database > Rules > Publish.
//
// request.auth chỉ có giá trị khi app gửi kèm một ID token (JWT) hợp lệ:
// server của Firebase kiểm chữ ký RS256, hạn dùng (exp), aud và iss của token
// rồi mới điền request.auth.uid. Không có token hoặc token giả thì bị từ chối.
service cloud.firestore {
  match /databases/{database}/documents {

    // Hồ sơ người dùng: chỉ chính chủ đọc/ghi.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && (!('email' in request.resource.data)
            || request.resource.data.email == request.auth.token.email);
      allow delete: if false;

      // Bản sao lưu dữ liệu nhóm.
      match /backups/{backupId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    function signedIn() {
      return request.auth != null;
    }

    function ledgerData(ledgerId) {
      return get(/databases/$(database)/documents/ledgers/$(ledgerId)).data;
    }

    // Sổ chung: chủ sổ ghi, thành viên (đã nhập mã mời) chỉ đọc.
    match /ledgers/{ledgerId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid];

      // Chủ sổ sửa dữ liệu sổ nhưng không được đổi chủ, và chỉ được BỚT
      // tài khoản (gỡ người). Thêm tài khoản chỉ đi qua mã mời (isJoining),
      // để chủ sổ không tự kéo người lạ vào sổ rồi gửi nhắc nợ giả.
      allow update: if signedIn() && (isOwnerEdit() || isJoining(ledgerId));

      function noNewKeys(newMap, oldMap) {
        return newMap.keys().toSet().difference(oldMap.keys().toSet()).size() == 0;
      }

      function isOwnerEdit() {
        let o = resource.data;
        let d = request.resource.data;
        return o.ownerUid == request.auth.uid
          && d.ownerUid == o.ownerUid
          && d.memberUids.toSet().difference(o.memberUids.toSet()).size() == 0
          && noNewKeys(d.links, o.links)
          && noNewKeys(d.linkNames, o.linkNames);
      }

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      // Người được mời tự thêm mình vào sổ. Chỉ được đụng tới phần của
      // chính mình, và phải có mã mời đúng của sổ này: tài khoản đứng tên
      // đúng thành viên ghi trong mã. Mã chưa ai dùng, còn hạn, và phải
      // được đánh dấu "đã dùng" bởi chính mình trong cùng lần ghi (batch).
      // Người đã ở trong sổ không nhập mã khác để đổi sang đứng tên người khác.
      function isJoining(ledgerId) {
        let code = request.resource.data.lastJoinCode;
        let invPath = /databases/$(database)/documents/invites/$(code);
        let inv = get(invPath).data;
        let me = request.auth.uid;
        let newData = request.resource.data;
        return newData.diff(resource.data).affectedKeys()
              .hasOnly(['memberUids', 'links', 'linkNames', 'lastJoinCode'])
          && !(me in resource.data.links)
          && inv.ledgerId == ledgerId
          && !('usedBy' in inv)
          && inv.get('expiresAt', request.time) > request.time
          && getAfter(invPath).data.get('usedBy', '') == me
          && newData.memberUids.toSet()
              == resource.data.memberUids.toSet().union([me].toSet())
          && newData.links.diff(resource.data.links).affectedKeys().hasOnly([me])
          && newData.links[me] == inv.memberId
          && newData.linkNames.diff(resource.data.linkNames).affectedKeys().hasOnly([me]);
      }
    }

    // Mã mời: ai đăng nhập cũng đọc được một mã nếu biết mã (không liệt kê
    // được). Chỉ chủ sổ tạo / xóa mã của sổ mình. Mã hết hạn sau tối đa
    // 7 ngày và chỉ dùng được một lần.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && ledgerData(request.resource.data.ledgerId).ownerUid == request.auth.uid
        && !('usedBy' in request.resource.data)
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt < request.time + duration.value(8, 'd');
      // Người nhập mã đánh dấu "đã dùng" đúng một lần, cùng lúc với việc
      // vào sổ (getAfter thấy mình đã đứng tên thành viên ghi trong mã).
      allow update: if signedIn()
        && !('usedBy' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['usedBy', 'usedAt'])
        && request.resource.data.usedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/ledgers/$(resource.data.ledgerId))
            .data.lastJoinCode == code
        && getAfter(/databases/$(database)/documents/ledgers/$(resource.data.ledgerId))
            .data.links[request.auth.uid] == resource.data.memberId;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // Nhắc nợ: chỉ chủ sổ gửi, và chỉ gửi cho tài khoản đang ở trong sổ.
    // Người nhận đọc được và chỉ được đánh dấu "đã nhận".
    match /notifications/{id} {
      allow read: if signedIn()
        && (resource.data.toUid == request.auth.uid
            || resource.data.fromUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && ledgerData(request.resource.data.ledgerId).ownerUid == request.auth.uid
        && request.resource.data.toUid in ledgerData(request.resource.data.ledgerId).memberUids
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.fromName is string
        && request.resource.data.fromName.size() <= 100
        && request.resource.data.ledgerName is string
        && request.resource.data.ledgerName.size() <= 100
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 1000
        && request.resource.data.amount is int;
      allow update: if signedIn()
        && resource.data.toUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['delivered', 'deliveredAt']);
      allow delete: if false;
    }

    // Ảnh đại diện công khai: ai đăng nhập cũng xem được ảnh của một tài
    // khoản nếu biết uid (lấy từ sổ chung), không liệt kê được. Chỉ chính chủ
    // ghi/xóa, chỉ có 2 trường, ảnh dưới ~400 KB.
    match /avatars/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['avatar', 'updatedAt'])
        && request.resource.data.avatar is string
        && request.resource.data.avatar.size() < 400000;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Mọi thứ khác: chặn.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
